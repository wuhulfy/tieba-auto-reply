# Copy to .env for local use. Never commit .env.
BDUSS=replace-with-your-own-bduss
TIEBA_USERNAME=replace-with-your-exact-displayed-nickname
TIEBA_USER_ID=replace-with-your-numeric-user-id
TIEBA_FORUM=hifi交易
REPLY_CONTENT=bd
DRY_RUN=true
MAX_REPLIES=20
THREAD_SCAN_LIMIT=100
MAX_THREAD_AGE_HOURS=6
REPLY_DELAY_MIN=5
REPLY_DELAY_MAX=10
